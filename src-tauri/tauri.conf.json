{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "2xKOKomboStorage",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node ../scripts/generate-icons.js && npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "2xKO Kombo Storage",
        "width": 1280,
        "height": 860,
        "minWidth": 1280,
        "minHeight": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
        "icons/Icon.png",
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
    ]
  }
}
